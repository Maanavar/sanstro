# Environment
.env
.env.local
.env.*.local

# Database backups (keep out of version control)
backups/
backup_*.sql

# Transient test / debug output
*.log
test_run_*.txt
web/artifacts/
web/e2e/.artifacts/
web/e2e-artifacts/
web/scripts/_debug-*.mjs
web/scripts/_dump-*.mjs
.coverage
web/playwright-report/
web/test-results/

# NOT `web/tests/` — that ignored the visual suite's SOURCE, not its output.
# fbed72d added it as "web/tests directory for test-generated files"; it holds
# tests/visual/quality-gates.spec.ts, so from 2026-06-26 the whole visual
# regression suite was invisible to git, to CI, and to every other checkout,
# while playwright.config.ts kept configuring three projects against it (two of
# which match nothing else). The genuine artifact directories are the two lines
# above.
#
# The rendered baselines DO stay out: Playwright names snapshots per platform
# (`home-chromium-win32.png`) and CI runs ubuntu-latest, so committing ~7 MB of
# win32 PNGs would give Linux a set it can never match.
web/tests/**/*-snapshots/

# Local tools and editor settings
.claude/
.claude/*local*.json
.vscode/
.idea/
.DS_Store

# Local debug files
*.local
*.local.*


# Background task logs (transient)
artifacts/

# Claude Design source exports — reference-only, never commit
/Astrology App Dashboard Redesign/

# Compose file-backed secrets (docker-compose.secrets.yml). Plaintext key
# material — never tracked. SEC-1 §5.4: no secrets in Git.
/secrets/

# Let's Encrypt state, created by the certbot service on first issuance.
# live/<domain>/privkey.pem is a private key; the webroot holds ACME challenge
# tokens. Both are per-deployment, neither belongs in the repo.
/docker/nginx/certs/
/docker/nginx/webroot/
