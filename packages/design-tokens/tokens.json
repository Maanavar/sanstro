{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "version": "1.0.0",
    "brand": "Vinaadi AI",
    "identity": "Warm Cosmic Minimalism"
  },

  "color": {
    "light": {
      "surface": {
        "0": { "value": "#FAF7F2", "comment": "Canvas / page background" },
        "1": { "value": "#F3EEE5", "comment": "Card background" },
        "2": { "value": "#EAE3D6", "comment": "Elevated card / hover state" },
        "3": { "value": "#DDD6C8", "comment": "Selected / active state" },
        "4": { "value": "#CFC7B5", "comment": "Sunken / inset elements" },
        "5": { "value": "#B8AFA0", "comment": "Borders / dividers" }
      },
      "text": {
        "primary":   { "value": "#1C1008", "comment": "Headings, primary body" },
        "secondary": { "value": "#4A3820", "comment": "Secondary body, labels" },
        "tertiary":  { "value": "#7A6448", "comment": "Captions, metadata" },
        "disabled":  { "value": "#A89880", "comment": "Disabled states" }
      },
      "accent": {
        "base":    { "value": "#C9971C", "comment": "Gold — primary accent" },
        "hover":   { "value": "#A87D18", "comment": "Accent on hover" },
        "subtle":  { "value": "#FDF3DC", "comment": "Accent background tint" }
      },
      "semantic": {
        "success":         { "value": "#2D7A4F" },
        "successSubtle":   { "value": "#EAF5EF" },
        "warning":         { "value": "#B86A00" },
        "warningSubtle":   { "value": "#FEF3E2" },
        "error":           { "value": "#C0392B" },
        "errorSubtle":     { "value": "#FDE8E6" },
        "info":            { "value": "#1D5EA8" },
        "infoSubtle":      { "value": "#E8F0FC" }
      },
      "overlay": { "value": "rgba(28, 16, 8, 0.5)" }
    },

    "dark": {
      "surface": {
        "0": { "value": "#0D0F1A", "comment": "Canvas / deep indigo" },
        "1": { "value": "#151825", "comment": "Card background" },
        "2": { "value": "#1E2235", "comment": "Elevated card / hover state" },
        "3": { "value": "#252A40", "comment": "Selected / active state" },
        "4": { "value": "#0A0C14", "comment": "Sunken / inset elements" },
        "5": { "value": "#2A3050", "comment": "Borders / dividers" }
      },
      "text": {
        "primary":   { "value": "#F0EBE0" },
        "secondary": { "value": "#B8A88A" },
        "tertiary":  { "value": "#7A6A50" },
        "disabled":  { "value": "#4A3E2E" }
      },
      "accent": {
        "base":    { "value": "#C9971C" },
        "hover":   { "value": "#E0AE28", "comment": "Brighter on dark" },
        "subtle":  { "value": "#1E1A0A" }
      },
      "semantic": {
        "success":         { "value": "#3DAA6A" },
        "successSubtle":   { "value": "#0A1E14" },
        "warning":         { "value": "#E08A20" },
        "warningSubtle":   { "value": "#1E1200" },
        "error":           { "value": "#E05040" },
        "errorSubtle":     { "value": "#1E0A08" },
        "info":            { "value": "#5080E0" },
        "infoSubtle":      { "value": "#080E1E" }
      },
      "overlay": { "value": "rgba(0, 0, 0, 0.7)" }
    }
  },

  "spacing": {
    "xs":  { "value": 4,  "unit": "px" },
    "sm":  { "value": 8,  "unit": "px" },
    "md":  { "value": 12, "unit": "px" },
    "lg":  { "value": 16, "unit": "px" },
    "xl":  { "value": 24, "unit": "px" },
    "2xl": { "value": 32, "unit": "px" },
    "3xl": { "value": 48, "unit": "px" },
    "4xl": { "value": 64, "unit": "px" }
  },

  "radius": {
    "sm":   { "value": 6,    "unit": "px" },
    "md":   { "value": 10,   "unit": "px" },
    "lg":   { "value": 16,   "unit": "px" },
    "xl":   { "value": 24,   "unit": "px" },
    "full": { "value": 9999, "unit": "px" }
  },

  "typography": {
    "fontFamily": {
      "display": { "value": "'Playfair Display', Georgia, serif" },
      "body":     { "value": "'Inter', system-ui, sans-serif" },
      "mono":     { "value": "'JetBrains Mono', monospace" },
      "displayTamil": { "value": "'Noto Serif Tamil', serif" },
      "bodyTamil":    { "value": "'Noto Sans Tamil', sans-serif" }
    },
    "scale": {
      "display":   { "size": 32, "weight": 700, "lineHeight": 1.2,  "letterSpacing": "-0.5px" },
      "heading1":  { "size": 24, "weight": 700, "lineHeight": 1.25, "letterSpacing": "-0.3px" },
      "heading2":  { "size": 20, "weight": 600, "lineHeight": 1.3,  "letterSpacing": "-0.2px" },
      "heading3":  { "size": 17, "weight": 600, "lineHeight": 1.35, "letterSpacing": "-0.1px" },
      "body":      { "size": 15, "weight": 400, "lineHeight": 1.6,  "letterSpacing": "0" },
      "small":     { "size": 13, "weight": 400, "lineHeight": 1.5,  "letterSpacing": "0.1px" },
      "caption":   { "size": 11, "weight": 500, "lineHeight": 1.4,  "letterSpacing": "0.2px" }
    }
  },

  "motion": {
    "spring": {
      "default": { "stiffness": 300, "damping": 20, "mass": 1 },
      "gentle":  { "stiffness": 200, "damping": 25, "mass": 1 },
      "snappy":  { "stiffness": 400, "damping": 15, "mass": 0.8 }
    },
    "duration": {
      "fast":   { "value": 150, "unit": "ms" },
      "base":   { "value": 250, "unit": "ms" },
      "slow":   { "value": 400, "unit": "ms" },
      "slower": { "value": 600, "unit": "ms" }
    },
    "easing": {
      "default": { "value": "cubic-bezier(0.4, 0, 0.2, 1)" }
    },
    "entranceRhythm": {
      "surface":    { "delay": 0,   "duration": 0 },
      "hero":       { "delay": 80,  "duration": 200 },
      "supporting": { "delay": 120, "stagger": 40 },
      "tertiary":   { "delay": 200, "duration": 300 }
    }
  },

  "icon": {
    "strokeWidth": { "value": 1.5, "unit": "px" },
    "size": {
      "inline":     { "value": 16, "unit": "px" },
      "button":     { "value": 20, "unit": "px" },
      "standalone": { "value": 24, "unit": "px" },
      "hero":       { "value": 32, "unit": "px" }
    }
  }
}
