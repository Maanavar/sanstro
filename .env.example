# Local Docker Postgres
JOTHIDAM_DATABASE_URL=postgresql://slw_admin:slw_dev_password@localhost:5432/vinaadi_dev
JOTHIDAM_ENVIRONMENT=development

# Rate limiting (per client IP)
# Keep enabled in production; loopback exemption only applies outside production.
JOTHIDAM_RATE_LIMIT_ENABLED=true
JOTHIDAM_RATE_LIMIT_WINDOW_SECONDS=60
JOTHIDAM_RATE_LIMIT_MAX_REQUESTS=120
JOTHIDAM_RATE_LIMIT_EXEMPT_LOOPBACK_IN_NON_PROD=true
# Number of trusted reverse-proxy hops in front of the app (0 = no proxy).
# Set to the count of proxies (e.g. nginx/ALB) so rate limiting sees the real client IP.
#
# SET THIS EQUAL TO TRUSTED_PROXY_HOPS_BEFORE_WEB. They describe the same
# deployment from two ends. Web strips every client-supplied x-forwarded-for and
# re-adds only the rightmost TRUSTED_PROXY_HOPS_BEFORE_WEB entries — the ones an
# edge we control actually wrote — so the API receives exactly that many and
# must step back exactly that many. Raising this while web forwards nothing makes
# the backend read an entry no trusted hop produced. The API refuses to boot in
# production if the two disagree.
JOTHIDAM_TRUSTED_PROXY_COUNT=0

# Hops in front of the NEXT server (CDN / ingress / load balancer). 0 = browsers
# reach Next directly, and Next forwards no x-forwarded-for at all.
#
# The matching pairs, in full (docs/PRODUCTION_EDGE.md §1) — always equal:
#   no edge          BEFORE_WEB=0  PROXY_COUNT=0
#   --profile edge   BEFORE_WEB=1  PROXY_COUNT=1
#   edge + CDN       BEFORE_WEB=2  PROXY_COUNT=2
# This file previously said the API's count stays 1 however deep the stack gets.
# It does not. Next replaces x-forwarded-for with its rightmost N entries, so the
# API sees N and must step back N; at BEFORE_WEB=2/PROXY_COUNT=1 it would read
# the CDN's own address for every request.
#
# WITHOUT AN EDGE, ANONYMOUS RATE LIMITING IS ONE SHARED BUCKET. Next forwards
# no client address, so the API attributes every browser request to the web
# container. Authenticated requests key by user id and are unaffected; login,
# register, password reset, geocoding and the public tools are not.
TRUSTED_PROXY_HOPS_BEFORE_WEB=0

# Scale-out backends (only needed when running more than one worker/box).
# Leave as the memory defaults for a single-box deploy.
#   redis: shared Redis URL used by the cache + rate limiter (requires the
#          optional `redis` package: pip install .[redis]).
JOTHIDAM_REDIS_URL=
#   rate limiter: "memory" (per-process, ~N x limit across N workers) or "redis"
#                 (cluster-wide). Falls back to memory if Redis is unreachable.
JOTHIDAM_RATE_LIMIT_BACKEND=memory
#   cache: "memory" (per-process) or "redis" (shared).
JOTHIDAM_CACHE_BACKEND=memory
# Whether GET /health/ready reports 503 when Redis is unreachable. Unset derives
# it: required only when the rate limiter uses Redis, since that fallback loosens
# a security control rather than merely cooling a cache. Setting it true makes a
# Redis outage mark the WHOLE fleet not-ready at once — fine if your ingress
# fails open on all-unhealthy, not fine otherwise. docs/PRODUCTION_EDGE.md §2.
JOTHIDAM_READINESS_REQUIRE_CACHE=
# Timeout in seconds on every Redis call. redis-py defaults to waiting forever,
# and Redis is in the rate limiter's request path.
JOTHIDAM_REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# TLS ingress (docker compose --profile edge). See docs/PRODUCTION_EDGE.md.
# Without these the edge service refuses to start, which is the intent — it is
# opt-in precisely so it never half-starts on a missing certificate.
VINAADI_DOMAIN=
CERTBOT_CONF_DIR=./docker/nginx/certs
CERTBOT_WEBROOT_DIR=./docker/nginx/webroot
# Whether the API process also runs the cron scheduler. Keep true on a single box.
# Set false and run a dedicated `python -m app.worker` process in a scaled deploy.
JOTHIDAM_RUN_SCHEDULER_IN_WEB=true

# CORS — comma-separated allowed origins. Leave empty for the server-to-server Next proxy.
# e.g. JOTHIDAM_CORS_ALLOW_ORIGINS=https://app.vinaadi.ai
JOTHIDAM_CORS_ALLOW_ORIGINS=

# Production hardening (required when JOTHIDAM_ENVIRONMENT=production):
#   JOTHIDAM_COOKIE_SECURE=true and JOTHIDAM_DEBUG=false are enforced at startup.
JOTHIDAM_COOKIE_SECURE=false
JOTHIDAM_DEBUG=false

# Auth - generate a strong random secret for production
JOTHIDAM_JWT_SECRET=replace-with-64-char-random-string

# Admin API key
JOTHIDAM_ADMIN_API_KEY=replace-with-strong-key

# MailHog (local dev) - swap for real SMTP in production
JOTHIDAM_SMTP_HOST=localhost
JOTHIDAM_SMTP_PORT=1025
JOTHIDAM_SMTP_USER=
JOTHIDAM_SMTP_PASS=
JOTHIDAM_NOTIFICATION_FROM_EMAIL=noreply@vinaadi.local
JOTHIDAM_NOTIFICATION_FROM_NAME=Vinaadi AI

# Encryption at rest (Fernet). Covers birth date/time/coordinates and, since
# P2-1, journal note text. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOTHIDAM_ENCRYPTION_KEY=replace-with-fernet-key
#
# Rotation form. Comma-separated, NEWEST FIRST: the first key encrypts, all of
# them decrypt. Takes precedence over JOTHIDAM_ENCRYPTION_KEY when set. Leave
# empty unless you are mid-rotation.
#
#   1. set KEYS=<new>,<old> and deploy
#   2. python -m scripts.rotate_encryption_key
#   3. python -m scripts.rotate_encryption_key --verify   <- must pass
#   4. back up, then drop <old>
#
# DROPPING THE OLD KEY BEFORE STEP 3 PASSES IS UNRECOVERABLE. Fernet cannot tell
# you which rows still need it, and step 2 finishing without an error is not
# evidence -- it succeeds under any configured key. Step 3 is what checks.
#
# Retiring a key is not destroying it: a backup taken before the rotation still
# needs the old key. Keep it in escrow at least as long as those backups.
# docs/DATA_PROTECTION.md §2.
JOTHIDAM_ENCRYPTION_KEYS=

# ---------------------------------------------------------------------------
# File-backed secrets
# ---------------------------------------------------------------------------
# Any setting above can arrive as a file instead of a value, by setting
# <NAME>_FILE to a path. The file's contents (whitespace-stripped) become the
# value. Intended for Docker/Compose secrets and mounted Kubernetes secrets:
#
#   JOTHIDAM_ENCRYPTION_KEYS_FILE=/run/secrets/encryption_keys
#   JOTHIDAM_JWT_SECRET_FILE=/run/secrets/jwt_secret
#
# Read the file, do not re-export it into the environment first -- an entrypoint
# that does `export X="$(cat /run/secrets/x)"` puts the secret straight back into
# /proc/<pid>/environ and docker inspect, which is what mounting it avoided.
#
# Setting both <NAME> and <NAME>_FILE to DIFFERENT values is refused at boot.
# There is no rule anyone would guess about which wins, and for the encryption
# key, guessing wrong writes rows under a key you do not think is live.
#
# See docker-compose.secrets.yml and docs/SEC1_SECRET_CUSTODY_RULING.md §6.

# Process role: "api" (serves HTTP) or "worker" (scheduler only, app/worker.py).
# Defaults to "api". A worker needs the encryption key but no auth secret, so
# declaring the role is what lets it run without JWT_SECRET/ADMIN_API_KEY. The
# default errs toward requiring more, never fewer.
JOTHIDAM_PROCESS_ROLE=api

# Days after a journal entry is ARCHIVED (the user deleted it, or their own
# retention window archived it) before it is permanently deleted by the daily
# `journal_purge` job. 0 = never, and that is the default on purpose: the right
# window is a product and legal decision, and guessing it destroys a user's
# writing. Nothing is hard-deleted until this is set. docs/DATA_PROTECTION.md §3.
JOTHIDAM_JOURNAL_PURGE_AFTER_DAYS=0

# Ask Vinaadi — Claude API (leave unset to disable; endpoint returns 503)
# The daily question cap is enforced by the DB-backed ask_vinaadi_usage table
# (FREE_DAILY_CHIPS); ASK_VINAADI_DAILY_LIMIT is retained for backward compat only.
JOTHIDAM_ANTHROPIC_API_KEY=
JOTHIDAM_ASK_VINAADI_DAILY_LIMIT=10

# RevenueCat webhook — copy the shared secret from RevenueCat dashboard
# → Platform Settings → Webhooks. Leave unset to disable (returns 503).
JOTHIDAM_REVENUECAT_WEBHOOK_SECRET=
