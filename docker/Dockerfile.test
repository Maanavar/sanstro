# syntax=docker/dockerfile:1
# Backend test image, pyswisseph binding (Python 3.12) -- the binding CI and
# production run. Used by test-docker.ps1, because Smart App Control blocks the
# host venv's swe.dll and tests/conftest.py imports app.main, so the host cannot
# collect a single test. See dev-docker.ps1's header.
#
# 3.12 matches ci.yml's python-version exactly. Do not "modernise" it to 3.13+
# without also moving CI: the point of this image is to reproduce what CI runs.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUTF8=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# build-essential is needed, not optional: pyswisseph publishes wheels for
# cp36-cp311 only, so 3.12 builds it from sdist. libpq-dev covers psycopg2 if
# its wheel ever stops matching. Unlike the runtime Dockerfile this image never
# serves traffic, so the toolchain can stay in it and there is no wheels stage.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential python3-dev libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Only the lock is copied. The source arrives as a read-only bind mount at run
# time, so editing a test does not invalidate this layer or need a rebuild --
# and nothing in the image can go stale except the dependencies themselves.
COPY requirements.txt ./
RUN pip install -r requirements.txt

# The [dev] extra from pyproject.toml, pinned to the same ranges.
RUN pip install "pytest>=8.0,<9.0" "pytest-cov>=5.0,<7.0" "httpx>=0.27,<1.0"

# Fail the BUILD if the binding is not importable, rather than at test time
# where it would read as a test failure.
# EPHEMERIS DATA GOES IN THE IMAGE, NOT THE BIND MOUNT.
#
# app/calculations/ephemeris.py resolves its .se1 directory to
# <repo root>/ephe when JOTHIDAM_SWISSEPH_PATH is unset. With the repo bind
# mounted from Windows at /src, that put every Swiss Ephemeris file read across
# the Docker Desktop mount boundary -- and the library reads them constantly.
# A full-suite run sat for FOURTEEN HOURS at 5%, at 23% CPU (I/O bound, not
# compute bound), with every faulthandler stack pointing into
# _calc_ut -> ephemeris file reads. CI never saw it: a GitHub runner reads the
# same files from local ext4.
#
# 2 MB of static reference data (sepl_18 / semo_18 / seas_18, 1800-2399 AD), so
# baking it in is free, and it is what the production Dockerfile already does.
# The env var is set so nothing falls back to the mounted copy.
COPY ephe /opt/ephe
ENV JOTHIDAM_SWISSEPH_PATH=/opt/ephe

RUN python -c "import swisseph; print('pyswisseph', swisseph.version)"

CMD ["python", "-m", "pytest", "tests"]
