# syntax=docker/dockerfile:1
# Backend test image, swisseph-ffi binding (Python 3.14).
#
# WHY THIS EXISTS. docs/vinaadi-fix-spec.md item 5: "Every ephemeris change must
# be tested on both." Today nothing tests this half. ci.yml pins
# python-version 3.12 in all three jobs, so CI only ever exercises pyswisseph;
# the swisseph-ffi branch was covered solely by the owner running tests on the
# 3.14 host venv -- which Smart App Control now blocks. That left the binding
# with zero coverage, and the fix-spec's own remedy (line 127, "add a job
# running pytest tests/test_ephemeris.py on Python 3.12 in addition to 3.14")
# has not been applied.
#
# The two branches of app/calculations/ephemeris.py are genuinely different
# code, not a thin shim -- the fix-spec records retflag being discarded in each
# one separately (items E1 and the MOSEPH fallback). So this is not redundant
# with the 3.12 image.
FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUTF8=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential python3-dev libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# requirements.txt carries the markers that pick the binding:
#   pyswisseph   ; python_version <  '3.14'
#   swisseph-ffi ; python_version >= '3.14'   <- selected here
COPY requirements.txt ./
RUN pip install -r requirements.txt
RUN pip install "pytest>=8.0,<9.0" "pytest-cov>=5.0,<7.0" "httpx>=0.27,<1.0"

# The DLL that Smart App Control blocks on Windows is libswe.so here, and code
# integrity is not involved. Proving it loads at build time keeps a load failure
# from being misread as a test failure.
# EPHEMERIS DATA GOES IN THE IMAGE, NOT THE BIND MOUNT.
#
# app/calculations/ephemeris.py resolves its .se1 directory to
# <repo root>/ephe when JOTHIDAM_SWISSEPH_PATH is unset. With the repo bind
# mounted from Windows at /src, that put every Swiss Ephemeris file read across
# the Docker Desktop mount boundary -- and the library reads them constantly.
# A full-suite run sat for FOURTEEN HOURS at 5%, at 23% CPU (I/O bound, not
# compute bound), with every faulthandler stack pointing into
# _calc_ut -> ephemeris file reads. CI never saw it: a GitHub runner reads the
# same files from local ext4.
#
# 2 MB of static reference data (sepl_18 / semo_18 / seas_18, 1800-2399 AD), so
# baking it in is free, and it is what the production Dockerfile already does.
# The env var is set so nothing falls back to the mounted copy.
COPY ephe /opt/ephe
ENV JOTHIDAM_SWISSEPH_PATH=/opt/ephe

RUN python -c "import swisseph_ffi; from swisseph_ffi.bindings import SwissEph; SwissEph(); print('swisseph-ffi binding loads')"

CMD ["python", "-m", "pytest", "tests/test_ephemeris.py"]
